{
  "name": "rest_api_nodejs",
  "version": "0.1.0",
  "description": "G4 API - REST API for user and task management (Node.js port)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "cross-env NODE_ENV=test jest --forceExit",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --forceExit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.0",
    "mysql2": "^3.11.0",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "eslint": "^8.57.0",
    "@eslint/js": "^9.12.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000,
    "forceExit": true,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js"
    ]
  }
}
